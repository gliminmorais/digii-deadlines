{
  "manifest_version": 3,
  "name": "Digii Deadlines",
  "version": "1.6.3",
  "minimum_chrome_version": "114",
  "description": "See upcoming deadlines and past assignments from your SNUC DigiiCampus Classroom.",
  "host_permissions": ["https://snuc.digiicampus.com/*"],
  "permissions": ["sidePanel", "storage"],
  "action": { "default_title": "Open Digii Deadlines" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://snuc.digiicampus.com/*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ]
}

