{
  "manifest_version": 3,
  "name": "Digii Deadlines",
  "version": "1.1.0",
  "description": "See upcoming assignment deadlines from your SNUC DigiiCampus Classroom.",
  "host_permissions": ["https://snuc.digiicampus.com/*"],
  "action": { "default_title": "Upcoming Deadlines", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://snuc.digiicampus.com/*"],
      "js": ["sync.js"],
      "run_at": "document_idle"
    }
  ]
}

